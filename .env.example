# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true

# Neon PostgreSQL
DATABASE_URL=

# S3-compatible object storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=

# Optional frontend test settings; export them in the shell.
# Playwright does not load this example file.
# Browser override: leave unset for Playwright's paired browser.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Next server mode for the visual tests: unset or "dev" (default), or "production" (rebuilds, never reuses running servers).
PLAYWRIGHT_NEXT_SERVER=
